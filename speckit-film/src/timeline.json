    {"id":"c0","t0":0.40,"t1":1.99,"text":"Bạn gõ một câu prompt mơ hồ."},
    {"id":"c1","t0":2.48,"t1":3.16,"text":"Nhấn Enter."},
    {"id":"c2","t0":3.64,"t1":4.18,"text":"Và cầu nguyện."},
    {"id":"c3","t0":4.97,"t1":5.65,"text":"Vài phút sau,"},
    {"id":"c4","t0":5.99,"t1":6.67,"text":"dự án của bạn…"},
    {"id":"c5","t0":7.40,"t1":7.90,"text":"vỡ vụn."},
    {"id":"c6","t0":8.86,"t1":10.35,"text":"Đó là cái giá của vibe coding."},
    {"id":"c7","t0":11.37,"t1":12.90,"text":"Nhưng GitHub đã tìm ra lời giải."},
    {"id":"c8","t0":13.56,"t1":14.52,"text":"Nó tên là Spec Kit."},
    {"id":"c9","t0":15.40,"t1":16.62,"text":"Ý tưởng cốt lõi chỉ có một:"},
