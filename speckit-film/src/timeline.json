    {"id":"c12","t0":22.33,"t1":22.81,"text":"Đầu tiên,"},
    {"id":"c13","t0":23.26,"t1":24.40,"text":"nó hiểu bạn muốn xây gì."},
    {"id":"c14","t0":25.24,"t1":26.31,"text":"Hỏi lại những gì còn thiếu."},
    {"id":"c15","t0":27.09,"t1":27.80,"text":"Tổ chức dự án."},
    {"id":"c16","t0":28.44,"t1":29.24,"text":"Và chỉ sau đó,"},
    {"id":"c17","t0":29.48,"t1":30.22,"text":"mới bắt đầu lập trình."},
    {"id":"c18","t0":31.17,"t1":32.94,"text":"Toàn bộ quy trình gói gọn trong sáu lệnh."},
    {"id":"c19","t0":33.92,"t1":34.63,"text":"Constitution:"},
    {"id":"c20","t0":35.02,"t1":35.90,"text":"quy tắc và tiêu chuẩn."},
    {"id":"c21","t0":36.52,"t1":37.20,"text":"Specify:"},
    {"id":"c22","t0":37.58,"t1":38.37,"text":"bạn muốn xây gì."},
    {"id":"c23","t0":38.96,"t1":39.63,"text":"Clarify:"},
    {"id":"c24","t0":39.95,"t1":41.07,"text":"làm rõ trước khi bắt đầu."},
    {"id":"c25","t0":41.72,"t1":42.03,"text":"Plan:"},
    {"id":"c26","t0":42.37,"t1":43.41,"text":"kiến trúc và công nghệ."},
    {"id":"c27","t0":44.06,"t1":44.35,"text":"Tasks:"},
    {"id":"c28","t0":44.79,"t1":45.67,"text":"nhiệm vụ theo thứ tự."},
    {"id":"c29","t0":46.33,"t1":46.90,"text":"Implement:"},
    {"id":"c30","t0":47.24,"t1":47.60,"text":"thực thi."},
    {"id":"c31","t0":48.55,"t1":48.97,"text":"Kết quả?"},
    {"id":"c32","t0":49.70,"t1":50.93,"text":"Ít giờ sửa lỗi ngớ ngẩn."},
    {"id":"c33","t0":51.68,"t1":52.53,"text":"Ít code vô nghĩa."},
    {"id":"c34","t0":53.17,"t1":54.68,"text":"Và kết quả dễ đoán hơn rất nhiều."},
    {"id":"c35a","t0":55.67,"t1":56.66,"text":"Nó chạy cùng Claude Code,"},
    {"id":"c35b","t0":57.13,"t1":57.59,"text":"Cursor,"},
    {"id":"c35c","t0":57.97,"t1":58.44,"text":"Copilot,"},
    {"id":"c35d","t0":58.97,"t1":59.41,"text":"Codex,"},
    {"id":"c35e","t0":59.75,"t1":60.62,"text":"Gemini CLI,"},
    {"id":"c35f","t0":60.91,"t1":62.50,"text":"và tổng cộng hơn bốn mươi agent."},
    {"id":"c36","t0":63.49,"t1":64.04,"text":"Mã nguồn mở."},
    {"id":"c37","t0":64.50,"t1":65.57,"text":"Do chính GitHub tạo ra."},
    {"id":"c38","t0":66.11,"t1":67.59,"text":"Hơn 145 nghìn sao."},
    {"id":"c39","t0":68.11,"t1":69.11,"text":"Hơn 13 nghìn lượt fork."},
    {"id":"c40","t0":69.94,"t1":71.73,"text":"Vì AI chưa bao giờ thiếu tốc độ."},
    {"id":"c41","t0":72.39,"t1":73.06,"text":"Thứ nó thiếu…"},
    {"id":"c42","t0":73.31,"t1":74.21,"text":"là một bản thiết kế."},
    {"id":"c43","t0":75.10,"t1":76.40,"text":"Repo ở bình luận đầu tiên."}
